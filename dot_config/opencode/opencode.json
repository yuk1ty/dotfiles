{
	"$schema": "https://opencode.ai/config.json",
	"formatter": true,
	"lsp": {
		"kotlin-ls": {
			"disabled": true
		},
		"kotlin": {
			"command": ["kotlin-lsp", "--stdio"],
			"extensions": [".kt", ".kts"]
		}
	},
	"permissions": [
		{
			"action": "subagent",
			"resource": "*",
			"effect": "allow"
		},
		{
			"action": "shell",
			"resource": "git *",
			"effect": "allow"
		},
		{
			"action": "shell",
			"resource": "gh *",
			"effect": "allow"
		},
		{
			"action": "shell",
			"resource": "rm *",
			"effect": "ask"
		},
		{
			"action": "external_directory",
			"resource": "/tmp/**",
			"effect": "allow"
		},
		{
			"action": "read",
			"resource": "*.env",
			"effect": "deny"
		},
		{
			"action": "read",
			"resource": "*.env.*",
			"effect": "deny"
		},
		{
			"action": "read",
			"resource": "*.env.example",
			"effect": "allow"
		}
	]
}
